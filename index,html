    <!-- SCRIPTS -->
    <script>
        // 1. Dynamic Products Database (Shared with our_peda.html)
        const productsData = [
            {
                id: 1,
                name: "Special Deoghar Peda",
                desc: "Pure traditional khoya peda, crafted with the authentic recipe of Baba Dham.",
                img: "https://images.unsplash.com/photo-1596561339395-6fdfbd211463?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80",
                badge: { text: "Best Seller", bg: "bg-golden" },
                order: 1,
                options: [
                    { weight: "250g", price: 120 },
                    { weight: "500g", price: 240, default: true },
                    { weight: "1 Kg", price: 480 }
                ]
            },
            {
                id: 2,
                name: "Premium Kesar Peda",
                desc: "Authentic khoya peda enriched with the goodness and aroma of pure saffron (Kesar).",
                img: "https://images.unsplash.com/photo-1605807646983-377bc5a76493?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80",
                badge: { text: "New", bg: "bg-maroon" },
                order: 2,
                options: [
                    { weight: "250g", price: 140 },
                    { weight: "500g", price: 280, default: true },
                    { weight: "1 Kg", price: 560 }
                ]
            },
            {
                id: 3,
                name: "Family Pack Peda",
                desc: "Perfect for gifting and sharing during festivals. Shuddh Deoghar taste in a larger quantity.",
                img: "https://images.unsplash.com/photo-1543419912-1f480373d528?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80",
                badge: { text: "Value Pack", bg: "bg-saffron" },
                order: 3,
                options: [
                    { weight: "1 Kg", price: 460, default: true },
                    { weight: "2 Kg", price: 920 }
                ]
            }
        ];

        function renderHomeProducts() {
            const grid = document.getElementById('home-product-grid');
            if (!grid) return;

            grid.innerHTML = productsData.map(product => {
                let defaultOptIndex = product.options.findIndex(opt => opt.default);
                if (defaultOptIndex === -1) defaultOptIndex = 0;
                
                const defaultPrice = product.options[defaultOptIndex].price;
                
                const optionsHTML = product.options.map((opt, i) => 
                    `<option value="${i}" ${i === defaultOptIndex ? 'selected' : ''}>${opt.weight}</option>`
                ).join('');

                const badgeHTML = product.badge ? 
                    `<div class="absolute top-4 left-4 ${product.badge.bg} text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">${product.badge.text}</div>` : '';

                return `
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col h-full">
                        <div class="relative h-64 md:h-72 w-full bg-gray-100 overflow-hidden group cursor-pointer">
                            <img src="${product.img}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            ${badgeHTML}
                        </div>
                        
                        <div class="p-6 flex flex-col flex-grow">
                            <h3 class="text-xl md:text-2xl font-serif font-bold text-naturalBrown mb-2">${product.name}</h3>
                            <p class="text-sm text-gray-600 mb-6 flex-grow">${product.desc}</p>
                            
                            <div class="flex justify-between items-end mb-6">
                                <div class="w-1/2 pr-2">
                                    <label class="block text-xs text-gray-500 mb-1 font-medium uppercase tracking-wide">Select Weight</label>
                                    <select class="w-full bg-cream border border-gray-200 rounded-md p-2.5 text-sm text-naturalBrown focus:outline-none focus:border-maroon focus:ring-1 focus:ring-maroon font-medium cursor-pointer" onchange="updatePrice(this, ${product.id})">
                                        ${optionsHTML}
                                    </select>
                                </div>
                                <div class="text-right">
                                    <span class="block text-xs text-gray-500 mb-1 font-medium uppercase tracking-wide">Price</span>
                                    <span class="block text-2xl font-bold text-maroon" id="price-${product.id}">₹${defaultPrice}</span>
                                </div>
                            </div>

                            <div class="flex gap-3">
                                <button class="flex-1 bg-maroon text-cream py-3.5 rounded-md font-semibold hover:bg-maroon/90 transition-colors shadow-md text-sm md:text-base">Buy Now</button>
                                <button class="bg-white border-2 border-maroon text-maroon p-3.5 rounded-md hover:bg-maroon hover:text-cream transition-colors flex items-center justify-center"><i class="ph ph-shopping-cart text-xl"></i></button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Price update logic for homepage
        function updatePrice(selectElement, productId) {
            const product = productsData.find(p => p.id === productId);
            if (product) {
                const selectedOptionIndex = selectElement.value;
                const newPrice = product.options[selectedOptionIndex].price;
                document.getElementById(`price-${productId}`).innerText = `₹${newPrice}`;
            }
        }

        // Initialize homepage products
        renderHomeProducts();

        // 1. Mobile Menu Toggle Logic
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        const menuIcon = mobileMenuBtn.querySelector('i');

        // Helper function to close menu
        function closeMobileMenu() {
            if (!mobileMenu.classList.contains('hidden')) {
                mobileMenu.classList.add('hidden');
                menuIcon.classList.remove('ph-x');
                menuIcon.classList.add('ph-list');
            }
        }

        mobileMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation(); 
            mobileMenu.classList.toggle('hidden');
            if(mobileMenu.classList.contains('hidden')) {
                menuIcon.classList.remove('ph-x'); menuIcon.classList.add('ph-list');
            } else {
                menuIcon.classList.remove('ph-list'); menuIcon.classList.add('ph-x');
            }
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', closeMobileMenu);
        });

        document.addEventListener('click', (e) => {
            if (!mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
                closeMobileMenu();
            }
        });

        const header = document.querySelector('header');
        window.addEventListener('scroll', () => {
            closeMobileMenu(); 
            if (window.scrollY > 20) header.classList.add('shadow-md');
            else header.classList.remove('shadow-md');
        });

        // 2. Slider Logic
        let currentSlideIndex = 0;
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.dot');
        let slideInterval;

        function updateSlider(index) {
            slides.forEach((slide, i) => {
                if(i === index) {
                    slide.classList.remove('opacity-0', 'z-0');
                    slide.classList.add('opacity-100', 'z-10');
                    dots[i].classList.replace('bg-white/50', 'bg-golden');
                    dots[i].classList.replace('hover:bg-white', 'bg-golden');
                } else {
                    slide.classList.remove('opacity-100', 'z-10');
                    slide.classList.add('opacity-0', 'z-0');
                    dots[i].classList.replace('bg-golden', 'bg-white/50');
                    dots[i].classList.add('hover:bg-white');
                }
            });
        }

        function nextSlide() {
            currentSlideIndex = (currentSlideIndex + 1) % slides.length;
            updateSlider(currentSlideIndex);
            resetInterval();
        }

        function prevSlide() {
            currentSlideIndex = (currentSlideIndex - 1 + slides.length) % slides.length;
            updateSlider(currentSlideIndex);
            resetInterval();
        }

        function goToSlide(index) {
            currentSlideIndex = index;
            updateSlider(currentSlideIndex);
            resetInterval();
        }

        function startInterval() {
            slideInterval = setInterval(nextSlide, 5000); 
        }

        function resetInterval() {
            clearInterval(slideInterval);
            startInterval();
        }

        startInterval();
    </script>
</body>
</html>
